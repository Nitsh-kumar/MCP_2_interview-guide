# Environment Variables — MCP Deep Practice Lab
# Copy this file to .env and fill in values where required.
# NEVER commit .env to version control.
# NEVER put real credentials here; use sandboxed values for educational exercises only.

# ─── Protocol Baseline ────────────────────────────────────────────────────────
# Do not change these unless intentionally testing version mismatches.
MCP_PROTOCOL_VERSION=2026-07-28
MCP_SDK_BASELINE=2.0.0

# ─── Local Server Settings ────────────────────────────────────────────────────
# Used by Streamable HTTP lessons and capstones.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# ─── Sandbox Filesystem (Capstone 01) ─────────────────────────────────────────
# Absolute path to the allowed read/write sandbox directory.
# Do NOT point this at a real project root or home directory.
MCP_SANDBOX_ROOT=./sandbox_data

# ─── Auth Mock (Lessons 14, Capstone 02) ──────────────────────────────────────
# Used only by the local educational OAuth mock. Not a real IdP.
MCP_AUTH_ISSUER=http://localhost:9000
MCP_AUTH_AUDIENCE=mcp-deep-practice
# HS256 secret for the local mock only. Use RS256 + JWKS in real deployments.
MCP_AUTH_SECRET=REPLACE_WITH_LOCAL_DEV_SECRET_ONLY

# ─── Optional: MCP Inspector ──────────────────────────────────────────────────
# Inspector target. Only needed when running manual Inspector sessions.
MCP_INSPECTOR_TARGET=http://127.0.0.1:8000

# ─── Optional: Docker Labs ────────────────────────────────────────────────────
# Set to true only after scripts/doctor.py confirms Docker is available.
MCP_DOCKER_LABS_ENABLED=false

# ─── Optional: PostgreSQL (Advanced Labs) ─────────────────────────────────────
# Only used in optional advanced and capstone labs. Default backend is SQLite.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mcp_lab

# ─── Optional: LLM Provider (Lesson 24 adapters) ─────────────────────────────
# ALL core curriculum exercises work without any LLM API key.
# Set only if you want to test real LLM-backed agent integration in Lesson 24.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
